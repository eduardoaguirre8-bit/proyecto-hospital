<div class="modal fade" id="modalGraficos" tabindex="-1" aria-labelledby="tituloGraficos" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div><h2 class="modal-title fs-5 fw-bold" id="tituloGraficos"><i class="bi bi-bar-chart-line me-2 text-success"></i>Gráficos de pacientes</h2>
                    <small class="text-secondary">Así van los registros actuales del hospital.</small></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-pills chart-tabs mb-3" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#gPab" type="button">Por pabellón</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#gDoc" type="button">Por doctor</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#gCon" type="button">Por consultorio</button></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="gPab"><img class="chart-img" data-src="<%= ctx %>/GraficoBarrasServlet?por=pabellon" alt="Pacientes por pabellón"></div>
                    <div class="tab-pane fade" id="gDoc"><img class="chart-img" data-src="<%= ctx %>/GraficoPastelServlet?por=doctor" alt="Pacientes por doctor"></div>
                    <div class="tab-pane fade" id="gCon"><img class="chart-img" data-src="<%= ctx %>/GraficoBarrasServlet?por=consultorio" alt="Pacientes por consultorio"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                <a class="btn btn-primary" href="<%= ctx %>/ReporteEstadisticoServlet" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf me-2"></i>Generar reporte</a>
            </div>
        </div>
    </div>
</div>
