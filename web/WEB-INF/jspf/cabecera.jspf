<%@page import="util.Html"%>
<%
    // Cada página define antes de incluir esta cabecera:
    //   String paginaActual  -> "dashboard" | "pacientes" | "nuevo"
    //   String tituloPagina  -> texto que se muestra en la pestaña y la barra superior
    String ctx = request.getContextPath();
    String sesionUsuario = (String) session.getAttribute("usuario");
    String sesionRol = (String) session.getAttribute("rol");
    if (sesionUsuario == null) sesionUsuario = "Usuario";
    if (sesionRol == null) sesionRol = "";
    String inicial = sesionUsuario.substring(0, 1).toUpperCase();
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= Html.esc(tituloPagina) %> | Hospital 2027</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="<%= ctx %>/css/estilo.css" rel="stylesheet">
</head>
<body>
<aside class="sidebar" id="sidebar">
    <a class="brand" href="<%= ctx %>/DashboardServlet"><i class="bi bi-heart-pulse-fill"></i><div>Hospital<span>2027</span></div></a>
    <div class="side-label">MENÚ</div>
    <nav class="side-nav">
        <a href="<%= ctx %>/DashboardServlet" class="<%= "dashboard".equals(paginaActual) ? "active" : "" %>"><i class="bi bi-speedometer2"></i> Panel general</a>
        <a href="<%= ctx %>/PacienteServlet?accion=listar" class="<%= "pacientes".equals(paginaActual) ? "active" : "" %>"><i class="bi bi-people"></i> Pacientes</a>
        <a href="<%= ctx %>/PacienteServlet?accion=nuevo" class="<%= "nuevo".equals(paginaActual) ? "active" : "" %>"><i class="bi bi-person-plus"></i> Nuevo paciente</a>
    </nav>
    <div class="side-label">REPORTES</div>
    <nav class="side-nav">
        <a href="<%= ctx %>/ReporteEstadisticoServlet" target="_blank" rel="noopener"><i class="bi bi-graph-up-arrow"></i> Reporte estadístico</a>
        <a href="<%= ctx %>/ReporteServlet" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf"></i> Listado de pacientes</a>
    </nav>
    <div class="side-user">
        <span class="avatar"><%= Html.esc(inicial) %></span>
        <div><b><%= Html.esc(sesionUsuario) %></b><small><%= Html.esc(sesionRol) %></small></div>
        <a href="<%= ctx %>/LogoutServlet" title="Cerrar sesión" aria-label="Cerrar sesión" data-logout><i class="bi bi-box-arrow-right"></i></a>
    </div>
</aside>
<div class="overlay" id="overlay"></div>
<div class="main">
    <header class="topbar">
        <button class="menu-btn" id="menuBtn" type="button" aria-label="Abrir menú"><i class="bi bi-list"></i></button>
        <div class="crumb">Hospital 2027 / <b><%= Html.esc(tituloPagina) %></b></div>
        <div class="fecha"><i class="bi bi-calendar3"></i> <span id="fechaHoy"></span></div>
    </header>
    <main class="content">
